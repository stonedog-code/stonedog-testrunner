__pycache__/
*.py[oc]
.venv
.pytest_cache/
.env
results.xml

# Per-platform venvs — the Mac uses .venv-macos over the share.
.venv-*/

# Agent instructions stay OUT of every repo under energy-solution: they are
# workspace- and machine-specific context, not part of the product.
CLAUDE.md
.claude/

# V3 runtime state. Private keys and the job database are per-machine and must
# never be committed — a shared private key is not a private key.
keys/
data/
trusted_runners/
*.pem

# ...EXCEPT the examples' placeholder directories. `trusted_runners/` above is
# right for a real deployment — a test server's public keys are per-machine and
# an operator drops them in — but each example MOUNTS that directory, so a fresh
# clone without it gets a compose mount pointing at nothing. Git cannot
# re-include a file whose parent directory is excluded, so the directory is
# un-ignored first and then the file.
!examples/*/trusted_runners/
!examples/*/trusted_runners/README.md

# PRDs live in the INTERNAL stonedog-prd repo, never here. `docs/prd` is a
# symlink into it, so the documents are where a person expects while this
# repository commits none of them. See the StoneDogCode CLAUDE.md.
docs/prd
