# Copy to .env and fill in. NEVER commit .env.
#
# NOTE: this directory is a Samba share, so a .env here is visible to every
# machine that mounts it. Keep real credentials out of it.

# ── which version to run ─────────────────────────────────────────────────────
# local  = V1: the API runs pytest on this machine
# github = V2: the API dispatches a GitHub Actions workflow
RUNTESTS_MODE=local

# ── Slack ────────────────────────────────────────────────────────────────────
# With SLACK_SIGNING_SECRET unset the server accepts UNVERIFIED requests and
# warns on every one. That is how test.sh works out of the box; set it as soon
# as anything real is pointed at this.
SLACK_SIGNING_SECRET=
# With SLACK_BOT_TOKEN unset, slack.py prints what it WOULD send and to which
# channel, and sends nothing. That is the intended default for local work.
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#testing

# ── authorisation (all three are separate checks; see config.py) ─────────────
# THE SERVER REFUSES TO START unless SLACK_SIGNING_SECRET and SLACK_TEAM_ID are
# set AND at least one of RUNTESTS_CHANNELS / RUNTESTS_USERS is. An empty
# allowlist used to mean "allow everyone", which is the opposite of what an
# empty allowlist looks like it means.
SLACK_TEAM_ID=
RUNTESTS_CHANNELS=
RUNTESTS_USERS=

# Set this ONLY on a machine where this process protects nothing and can reach
# nothing. It starts the server with every protection above absent, and says so
# on every start. `bash run.sh` sets it for you locally; no image ever does.
RUNTESTS_INSECURE_DEV=

# ── V1 ───────────────────────────────────────────────────────────────────────
RUNTESTS_SUITE_ROOT=tests/sample

# ── the store ────────────────────────────────────────────────────────────────
# A FILE IS THE DEFAULT, and that is what makes a standalone runner zero-config:
# no database to stand up, nothing to configure, one file you can delete.
#
# EDGE_DB_DSN (or RUNTESTS_DB_DSN for V1/V2) is the ONLY way to select Postgres,
# and setting it wins over the path. Do that when the process has no durable
# disk — a Lightsail container has no persistent volume, so a file store there
# is deleted on every redeploy, taking the queue and the run history with it.
EDGE_DB_PATH=data/edge.db
EDGE_DB_DSN=
RUNTESTS_DB_PATH=data/runtests.db
RUNTESTS_DB_DSN=
RUNTESTS_DB_BUSY_TIMEOUT=5
# How long a write waits for a lock before the caller is told the runner is
# busy. Bounded well inside Slack's three-second budget: a handler that waits
# longer than Slack does produces a retry.
EDGE_DB_BUSY_TIMEOUT=5

# ── concurrency caps (0 disables any of them) ────────────────────────────────
# Three caps doing three different jobs, all enforced inside the store's own
# transactions — a check in one statement and a claim in the next is not a cap.
# How many runs of the same (product, server) may be in flight at once. One by
# default: typing the same command twice while the first is still going is a
# mistake far more often than a request.
RUNTESTS_MAX_ACTIVE_PER_JOB=1
# The "a chat box cannot queue fifty runs" cap.
RUNTESTS_MAX_QUEUED_PER_CHANNEL=10
# How many of one channel's runs may occupy test servers at once, so one busy
# channel cannot starve every other one.
RUNTESTS_MAX_RUNNING_PER_CHANNEL=3

# ── V2 ───────────────────────────────────────────────────────────────────────
GITHUB_REPO=your-org/test-automation
GITHUB_WORKFLOW_FILE=runtests.yml
GITHUB_REF_NAME=main
# A GitHub App installation token — one repo, actions:write, ~1h TTL. NOT a
# personal access token that outlives the person who made it.
GITHUB_TOKEN=
