# STRATEGY A — copy to .env and replace every value.
#
# Nothing here is a working default and none of it should be. The server
# refuses to start until the first two are set and at least one of the second
# two is, so a file copied and not edited produces a refusal naming exactly
# what is missing — not a bot that quietly accepts commands from anyone.

# From your Slack app's Basic Information page.
SLACK_SIGNING_SECRET=

# Your workspace id, from any Slack URL or the app's install page. A valid
# signature proves a request came from Slack; this is what proves it came from
# YOUR Slack.
SLACK_TEAM_ID=T00000000

# At least ONE of these. Channel ids and user ids, comma separated — ids, not
# names, because names are renameable and ids are not.
#
# Channels OR users, not both: a small team may reasonably allow any channel and
# restrict people, or the reverse.
RUNTESTS_CHANNELS=C00000000
RUNTESTS_USERS=

# Optional. A bearer token for GET /admin/fleet, which lists your test servers.
# Left empty, that endpoint 404s — default deny, because "which internal
# machines exist and when were they last seen" is reconnaissance.
EDGE_ADMIN_TOKEN=
