# STRATEGY B — copy to .env and replace every value.

SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=T00000000
RUNTESTS_CHANNELS=C00000000
RUNTESTS_USERS=

# The database. In a real embedded deployment this is the one your app already
# uses — point EDGE_DB_DSN at it in compose.yml and delete the `db` service.
POSTGRES_USER=testrunner
POSTGRES_PASSWORD=
POSTGRES_DB=testrunner

# Where the app in front listens.
APP_PORT=8080
