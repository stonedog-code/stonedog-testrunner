# STRATEGY B — copy to .env and replace every value.

SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=T00000000
RUNTESTS_CHANNELS=C00000000
RUNTESTS_USERS=

# The database. In a real embedded deployment this is the one your app already
# uses — point EDGE_DB_DSN at it in compose.yml and delete the `db` service.
POSTGRES_USER=testrunner
POSTGRES_DB=testrunner

# The password is used TWICE, in two different encodings: Postgres wants it raw,
# and EDGE_DB_DSN puts it inside a URI. That is a trap with no error message, so
# the simple path is the default:
#
#   USE A PASSWORD OF UNRESERVED CHARACTERS ONLY — A-Z a-z 0-9 - . _ ~
#   openssl rand -hex 32
#
# Then both encodings are the same string and you set only POSTGRES_PASSWORD.
POSTGRES_PASSWORD=

# ONLY if your password is fixed and contains reserved characters (@ / ? # : %).
# Set the raw password above and its percent-encoded form here:
#
#   python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=""))' 'p@ss/w0rd'
#   p%40ss%2Fw0rd
#
# Getting this wrong in either direction fails at connect time and blames the
# host, not the password. examples/verify.sh runs this two-variable path with a
# password full of reserved characters, so it is exercised rather than asserted.
EDGE_DB_PASSWORD_ENCODED=
